<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cardview_dark_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/darkblue"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🖨️ Reimpressão de Comprovantes"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reimprima vias de transações anteriores"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Card com informações da última transação -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/darkblue2">

            <TextView
                android:id="@+id/tvLastTransaction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carregando informações..."
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:padding="16dp"
                android:lineSpacingExtra="4dp" />

        </androidx.cardview.widget.CardView>

        <!-- Botões de Reimpressão -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecione o tipo de via:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp" />

        <!-- Via do Cliente -->
        <Button
            android:id="@+id/btnReprintCustomer"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="👤 Via do Cliente"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@color/orang"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp"
            android:drawablePadding="8dp" />

        <!-- Via do Estabelecimento -->
        <Button
            android:id="@+id/btnReprintEstablishment"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🏪 Via do Estabelecimento"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@color/blue"
            android:textColor="@android:color/white"
            android:layout_marginBottom="24dp"
            android:drawablePadding="8dp" />

        <!-- Informações adicionais -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/black_overlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️ Informações:"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Via do Cliente: Para entregar ao portador do cartão"
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Via do Estabelecimento: Para arquivo interno"
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Verifique se há papel na impressora"
                    android:textSize="12sp"
                    android:textColor="@color/gray" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Espaçador flexível -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botão Voltar -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="⬅️ Voltar"
            android:textSize="16sp"
            android:background="@color/yello"
            android:textColor="@android:color/white" />

    </LinearLayout>

</ScrollView>