<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/cardview_dark_background">

    <TextView
        android:id="@+id/tvPixTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pagamento PIX"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/yello"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPixAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Valor: R$ 45,00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/orang"
        android:layout_marginBottom="20dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/darkblue2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivQRCode"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:background="@android:color/white"
                android:src="@android:drawable/ic_menu_gallery" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escaneie o QR Code com seu banco ou carteira digital"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:textAlignment="center"
        android:layout_marginBottom="16dp" />

    <!-- Código PIX como texto (inicialmente oculto) -->
    <TextView
        android:id="@+id/tvQRCodeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Código PIX"
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:textAlignment="center"
        android:background="@color/darkblue2"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="@color/yello" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aguardando pagamento..."
            android:textSize="12sp"
            android:textColor="@color/yello" />

    </LinearLayout>



    <!-- Botões -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCopyCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copiar Código"
            android:textSize="14sp"
            android:background="@color/blue"
            android:textColor="@android:color/white"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar PIX"
            android:textSize="12sp"
            android:background="@drawable/ripple_effect2"
            android:textColor="@color/TextButtonColor"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />

    </LinearLayout>

</LinearLayout>