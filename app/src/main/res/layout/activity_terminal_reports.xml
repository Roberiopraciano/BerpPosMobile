<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cardview_dark_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/darkblue"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Relatórios do Terminal"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Relatórios detalhados do sistema"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Botões de Relatórios -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecione o tipo de relatório:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnSyntheticReport"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="📋 Sintético"
                android:textSize="12sp"
                android:background="@color/orang"
                android:textColor="@android:color/white"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnAnalyticReport"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="📈 Analítico"
                android:textSize="12sp"
                android:background="@color/blue"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnDetailedReport"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="📄 Detalhado"
                android:textSize="12sp"
                android:background="@color/green"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- Status do Terminal -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/darkblue2">

            <TextView
                android:id="@+id/tvReportStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carregando status..."
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:padding="16dp"
                android:lineSpacingExtra="4dp" />

        </androidx.cardview.widget.CardView>

        <!-- Conteúdo do Relatório -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/black_overlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📋 Conteúdo do Relatório"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@android:color/white" />

                    <Button
                        android:id="@+id/btnPrintReport"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:text="🖨️ Imprimir"
                        android:textSize="11sp"
                        android:background="@color/orang"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="12dp"
                        android:enabled="false" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvReportContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Processando relatórios..."
                    android:textSize="11sp"
                    android:textColor="@color/gray"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="20"
                    android:scrollbars="vertical" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Informações sobre os relatórios -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/black_overlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️ Tipos de Relatório:"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Sintético: Resumo financeiro consolidado"
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Analítico: Análise detalhada por categorias"
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Detalhado: Listagem completa de transações"
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Relatórios são gerados em tempo real pelo terminal"
                    android:textSize="11sp"
                    android:textStyle="italic"
                    android:textColor="@color/yello" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Espaçador flexível -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botão Voltar -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="⬅️ Voltar"
            android:textSize="16sp"
            android:background="@color/yello"
            android:textColor="@android:color/white" />

    </LinearLayout>

</ScrollView>