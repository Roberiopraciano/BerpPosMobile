<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/cardview_dark_background">

    <!-- Ícone de impressora -->
    <ImageView
        android:id="@+id/ivPrintIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_menu_agenda"
        android:layout_marginBottom="16dp"
        app:tint="@color/orang" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvPrintTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Imprimir Via do Cliente?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Informações da transação -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/darkblue2">

        <TextView
            android:id="@+id/tvTransactionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transação aprovada\nValor: R$ 25,90\nCartão: ****1234"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:padding="16dp"
            android:lineSpacingExtra="4dp" />

    </androidx.cardview.widget.CardView>

    <!-- Pergunta -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deseja imprimir a via do cliente?"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Botões -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">
        <!-- Botão NÃO -->
        <Button
            android:id="@+id/btnPrintNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NÃO"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:layout_marginEnd="2dp"

            android:background="@drawable/ripple_effect2"
            android:textColor="@color/TextButtonColor"
            android:layout_marginStart="8dp"
            android:paddingVertical="12dp" />

        <!-- Botão SIM -->
        <Button
            android:id="@+id/btnPrintYes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SIM"
            android:padding="12dp"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginStart="2dp"
            android:background="@drawable/ripple_effect2"
            android:textColor="@color/TextButtonColor"
            android:layout_marginEnd="8dp"
            android:paddingVertical="12dp" />



    </LinearLayout>

    <!-- Botão Cancelar (opcional) -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancelar"
        android:textSize="14sp"
        android:background="@color/gray"
        android:textColor="@android:color/white"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        android:visibility="gone" />

</LinearLayout>