<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/cardview_dark_background">

    <!-- Ícone de impressora -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_menu_agenda"
        android:layout_marginBottom="16dp"
        android:tint="@color/yello" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvReprintTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reimprimir Comprovante"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Informações da transação -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/darkblue2">

        <TextView
            android:id="@+id/tvTransactionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Última transação\nValor: R$ 25,90\nCartão: ****1234"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:padding="16dp"
            android:lineSpacingExtra="4dp" />

    </androidx.cardview.widget.CardView>

    <!-- Pergunta -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Qual via deseja reimprimir?"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Botão Via do Cliente -->
    <Button
        android:id="@+id/btnReprintCustomer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👤 Via do Cliente"
        android:textSize="12sp"
        android:textStyle="bold"


        android:background="@drawable/ripple_effect2"
        android:textColor="@color/TextButtonColor"
        android:layout_marginBottom="12dp"
        android:paddingVertical="16dp"
        android:drawablePadding="8dp" />

    <!-- Botão Via do Estabelecimento -->
    <Button
        android:id="@+id/btnReprintEstablishment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏪 Via do Estabelecimento"
        android:textSize="12sp"
        android:textStyle="bold"


        android:background="@drawable/ripple_effect2"
        android:textColor="@color/TextButtonColor"
        android:layout_marginBottom="16dp"
        android:paddingVertical="16dp"
        android:drawablePadding="8dp" />

    <!-- Botão Cancelar -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancelar"
        android:textSize="12sp"


        android:background="@drawable/ripple_effect2"
        android:textColor="@color/TextButtonColor"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp" />

</LinearLayout>