<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cardview_dark_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/darkblue"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Vendas por Produto"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Relatório detalhado de vendas e ranking de produtos"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Botões de Ação -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnSelectPeriod"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="📅 Período"
                android:textSize="11sp"
                android:background="@color/blue"
                android:textColor="@android:color/white"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnFilterCategory"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="🏷️ Categoria"
                android:textSize="11sp"
                android:background="@color/orang"
                android:textColor="@android:color/white"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnRefreshProducts"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="🔄 Atualizar"
                android:textSize="11sp"
                android:background="@color/green"
                android:textColor="@android:color/white"
                android:layout_marginStart="2dp" />

        </LinearLayout>

        <!-- Botão Imprimir -->
        <Button
            android:id="@+id/btnPrintReport"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="🖨️ Imprimir Relatório"
            android:textSize="14sp"
            android:background="@color/yello"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp"
            android:enabled="false" />

        <!-- Informações do Período -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/darkblue2">

            <TextView
                android:id="@+id/tvPeriodInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carregando informações do período..."
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:padding="16dp"
                android:lineSpacingExtra="3dp" />

        </androidx.cardview.widget.CardView>

        <!-- Resumo da Análise -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/black_overlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Análise de Vendas"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvSalesSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Processando dados..."
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Detalhes dos Produtos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/black_overlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛍️ Ranking de Produtos"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvProductsData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consultando API..."
                    android:textSize="10sp"
                    android:textColor="@color/gray"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="35"
                    android:scrollbars="vertical" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Informações da API -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/black_overlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 Funcionalidades da API:"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Ranking completo de produtos por vendas"
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Filtros por período (hoje, semana, mês)"
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Análise por categoria de produtos"
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Receita total e preço médio por produto"
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Top 3 produtos mais vendidos"
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Relatório detalhado para impressão"
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Dados demo disponíveis offline"
                    android:textSize="12sp"
                    android:textColor="@color/gray" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Espaçador flexível -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botão Voltar -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="⬅️ Voltar"
            android:textSize="16sp"
            android:background="@color/yello"
            android:textColor="@android:color/white" />

    </LinearLayout>

</ScrollView>